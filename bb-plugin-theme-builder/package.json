{
  "name": "bb-plugin-theme-builder",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.47"
  },
  "bb": {
    "name": "Theme Builder",
    "description": "Create, preview, save, and apply light and dark palettes with one-step restore.",
    "branding": {
      "icon": "Palette"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "build": "bb plugin build",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "duplicates": "jscpd src --threshold 0 --reporters console --ignore '**/*.test.ts'",
    "smoke": "node tests/theme-builder.e2e.ts",
    "smoke:randomizer": "node tests/randomizer.e2e.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@get-bb/plugin-sdk": "0.4.47",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "4.13.16",
    "jscpd": "4.2.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
